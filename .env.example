# ── local development ────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DATABASE_URL=postgres://duoverse:duoverse@localhost:5432/duoverse
CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# LLM stitching (optional: without a key the report is assembled from knowledge blocks only)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Fernet key for birth data and questionnaire answers at rest. Required in production.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# One-tap sign-in (optional; a button shows only when its keys are set)
# Yandex ID: oauth.yandex.ru → new app, Redirect URI https://<domain>/login/yandex/callback/, access «Доступ к адресу электронной почты»
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID: id.vk.ru/business/go → web app, trusted redirect https://<domain>/login/vk/callback/, access «Почта»
VK_CLIENT_ID=
VK_SERVICE_TOKEN=
# Telegram: @BotFather → new bot, then /setdomain <domain>
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Notifications and payments
SITE_URL=http://localhost:8000
# YooKassa: test shop first (https://yookassa.ru), webhook https://<domain>/yookassa/webhook/
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1

# Optional: full Swiss Ephemeris files (seas_18.se1) — enables Chiron
# SE_EPHE_PATH=/app/ephe

# ── production (docker-compose.prod.yml) ─────────────────────────────
# DJANGO_DEBUG=0
# DOMAIN=duoverse.example.com
# DJANGO_ALLOWED_HOSTS=duoverse.example.com
# POSTGRES_PASSWORD=<long random string>
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# DEFAULT_FROM_EMAIL=Duoverse <hello@duoverse.example.com>
# PRIVACY_EMAIL=privacy@duoverse.example.com
# ERROR_EMAILS=you@example.com          # 500 errors are emailed here (form values masked)
# BACKUP_KEEP_DAYS=14                   # nightly backups in ./backups
# LOG_LEVEL=INFO
